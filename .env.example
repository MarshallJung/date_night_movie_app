# GEMINI_API_KEY: Required for server-side Gemini API calls (Search grounding, Regency pitch writing, and faux poster generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SHARE_TOKEN_SECRET: Optional 32+ character secret used to encrypt covert /parlor/:token links.
# If omitted, the server generates an ephemeral key per runtime process.
SHARE_TOKEN_SECRET=""
